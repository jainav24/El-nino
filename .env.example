# App Settings
APP_VERSION=1.0.0
MODEL_VERSION=cox-ph-v1
LOG_LEVEL=INFO

# Database Settings
# For local SQLite development (default):
DATABASE_URL=sqlite:///./predictions.db

# For PostgreSQL connection (change user, password, dbname, host, and port as needed):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agririsk_db

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Security Settings (if needed for Auth later)
# SECRET_KEY=your-super-secret-jwt-key
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
